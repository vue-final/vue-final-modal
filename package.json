{
  "name": "vfm",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsdown -F vue-use-template -F @hunterliu/scroll-lock && tsdown -F vue-final-modal",
    "dev": "concurrently \"pnpm:dev:docs\" \"pnpm:dev:viteplay\"",
    "dev:docs": "pnpm --filter docs dev",
    "build:docs": "pnpm --filter docs build",
    "generate:docs": "pnpm --filter docs generate",
    "dev:viteplay": "pnpm --filter viteplay dev",
    "build:viteplay": "pnpm --filter viteplay build",
    "dev:vfm": "pnpm --filter vue-final-modal dev",
    "build:vfm": "pnpm --filter vue-final-modal build",
    "test:vfm": "pnpm --filter vue-final-modal cypress:run",
    "release:vfm": "pnpm --filter vue-final-modal release",
    "lint": "eslint . --ext=.ts,.vue --fix",
    "typecheck": "pnpm --parallel typecheck",
    "postinstall": "pnpm build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "better-sqlite3",
      "cypress",
      "esbuild",
      "sharp",
      "vue-demi"
    ],
    "packageExtensions": {
      "@nuxtjs/mcp-toolkit": {
        "dependencies": {
          "@nuxt/devtools-kit": "^3.2.4"
        }
      }
    },
    "overrides": {
      "@typescript-eslint/eslint-plugin@^8": "8.71.0"
    }
  },
  "devDependencies": {
    "@antfu/eslint-config": "^0.37.0",
    "@types/node": "^20.14.1",
    "@typescript-eslint/eslint-plugin": "5.62.0",
    "@typescript-eslint/parser": "5.62.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "concurrently": "^8.2.2",
    "eslint": "^8.36.0",
    "eslint-plugin-antfu": "0.37.0",
    "eslint-plugin-markdown": "3.0.1",
    "eslint-plugin-no-only-tests": "3.1.0",
    "eslint-plugin-unused-imports": "2.0.0",
    "pnpm": "^9.12.0",
    "tsdown": "0.22.5",
    "typescript": "^6.0.3",
    "vite": "^6.4.3",
    "vue-tsc": "^3.3.7"
  }
}
