{
  "name": "vue-use-template",
  "type": "module",
  "version": "0.4.0",
  "packageManager": "pnpm@10.33.2",
  "description": "vue use template",
  "author": "Hunter Liu <hunterliu1003@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/hunterliu1003/vue-use-template#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hunterliu1003/vue-use-template.git"
  },
  "bugs": "https://github.com/hunterliu1003/vue-use-template/issues",
  "keywords": [],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.cts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "vue-tsc && tsdown",
    "lint": "eslint . --fix",
    "typecheck": "vue-tsc --noEmit",
    "release": "pnpm build && pnpm test:unit && pnpm cypress:run && release-it",
    "test:unit": "vitest run",
    "cypress:open": "cypress open --browser electron --component",
    "cypress:run": "cypress run --component",
    "test:nuxt": "tsdown && pnpm --filter ./examples/nuxt build && node scripts/test-nuxt.mjs",
    "prepare": "simple-git-hooks"
  },
  "peerDependencies": {
    "vue": ">=3.3.0",
    "vue-component-type-helpers": ">=2.1.6"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "cypress": "^16.1.1",
    "eslint": "^10.12.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.2",
    "lint-staged": "^17.6.0",
    "release-it": "^21.1.0",
    "simple-git-hooks": "^2.9.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3",
    "vue": "^3.5.12",
    "vue-component-type-helpers": "^3.3.12",
    "vue-tsc": "^3.3.12"
  },
  "simple-git-hooks": {
    "pre-commit": "node_modules/.bin/lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix --no-warn-ignored"
  }
}
