{
  "github": {
    "release": true
  },
  "git": {
    "requireCleanWorkingDir": false,
    "tagName": "v${version}",
    "tagMatch": "v[0-9]*"
  },
  "plugins": {
    "@release-it/conventional-changelog": {
      "preset": "angular",
      "infile": "CHANGELOG.md",
      "ignoreRecommendedBump": true
    }
  }
}
